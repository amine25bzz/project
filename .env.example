# إعدادات الاتصال بـ MongoDB
# استبدل الرابط أدناه برابط الاتصال الخاص بك (MongoDB Atlas URI)
# مثال: mongodb+srv://username:password@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# اسم قاعدة البيانات والمجموعة (كما حددتها)
DB_NAME=linkapp
COLLECTION_NAME=linkapppro

# منفذ السيرفر
PORT=5000
